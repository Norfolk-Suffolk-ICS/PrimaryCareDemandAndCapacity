   "source": [
    "# Apply a 12-month moving average to smooth out the 'Predicted appointments per month' columns\n",
    "smoothed_df_predicted = projections_combined_df.copy()\n",
    "for col in smoothed_df_predicted.columns:\n",
    "    if 'Predicted appointments per month' in col:\n",
    "        smoothed_df_predicted[col] = smoothed_df_predicted.groupby('Sub-ICB')[col].rolling(window=12, min_periods=12).mean().reset_index(level=0, drop=True)\n",
    "        # This will make first 11-12 rows as nans because min_periods=12\n",
    "smoothed_df_predicted.head()"
   ]
